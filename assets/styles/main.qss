/* ============================================================
   GLOBAL
   ============================================================
*/
QWidget {
    background-color: #1a1a1a;
    color: #d4d4d4;
    font-size: 12px;
}

QMainWindow {
    background-color: #1a1a1a;
}

/* ============================================================
   SPLASH SCREEN
   ============================================================
*/
#splashContainer {
    border-radius: 20px;
}

#splashTitle {
    color: white;
    font-size: 22px;
    font-weight: 600;
}

/* ============================================================
    MENU BAR & MENU
   ============================================================
*/
QMenuBar {
    background-color: #181818;
    color: #d4d4d4;
    border-bottom: 1px solid #2a2a2a;
    padding: 2px;
}

QMenuBar::item {
    padding: 4px 10px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #2d5f8a;
    color: #ffffff;
}

QMenu {
    background-color: #232323;
    border: 1px solid #333333;
    color: #d4d4d4;
    min-width: 150px;
}

QMenu::item:selected {
    background-color: #2d5f8a;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #5a5a5a;
    background-color: transparent;
}

/* ============================================================
   TOOLBAR
   ============================================================ 
*/
#Toolbar {
    background-color: #202020;
    border-bottom: 1px solid #2a2a2a;
}

/* ============================================================
   BUTTONS
   ============================================================
*/
QPushButton {
    background-color: #2b2b2b;
    border: 1px solid #3a3a3a;
    border-radius: 3px;
    padding: 5px 12px;
    color: #d4d4d4;
}

QPushButton:hover {
    background-color: #34506b;
    border: 1px solid #4a7ba6;
}

QPushButton:pressed {
    background-color: #2d5f8a;
}

QPushButton:disabled {
    color: #6a6a6a;
    background-color: #232323;
    border: 1px solid #2a2a2a;
}

/* ============================================================
   INPUT CONTROLS
   (ComboBox, LineEdit, SpinBox)
   ============================================================
*/
QComboBox,
QLineEdit,
QSpinBox {
    background-color: #252525;
    border: 1px solid #3a3a3a;
    border-radius: 3px;
    padding: 3px 6px;
    color: #d4d4d4;
    selection-background-color: #2d5f8a;
}

#SearchBar {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 0px;
    color: #d4d4d4;
}

#SearchBar:focus {
    background-color: #2a2a2a;
    color: #ffffff;
    border-bottom: 1.2px solid #555555;
}

#MenuRow {
    background-color: #181818;
    color: #d4d4d4;
    border-bottom: 1px solid #2a2a2a;
}

QComboBox::drop-down {
    border: none;
}

/* ============================================================
   DRAG & DROP AREA
   ============================================================
*/
#DropArea {
    border: 2px dashed #3a3a3a;
    border-radius: 6px;
    background-color: #202020;
}

#DropArea QLabel {
    color: #7a7a7a;
}

/* ============================================================
   TABLE WIDGET
   ============================================================
*/
QHeaderView::section {
    background-color: #232323;
    color: #b8b8b8;
    padding: 1px 3px;
    border: none;
    border-top: 1px solid #555555;
    border-right: 1px solid #363636;
    border-bottom: 1px solid #000;
}

QTableWidget {
    background-color: #1c1c1c;
    /* alternate-background-color: #212121; */
    gridline-color: #2a2a2a;
    border: 1px solid #2a2a2a;
    outline: none;
}

QTableWidget::item {
    padding: 3px 6px;
    border-bottom: 1px solid #232323;
}

QTableWidget::item:selected {
    background-color: #4d4d4d;
    color: #ffffff;
}

QTableWidget::item:selected:!active {
    background-color: #3a3a3a;
    color: #e0e0e0;
}

/* ============================================================
   TEXT EDITOR
   ============================================================
*/
QPlainTextEdit {
    background-color: #141414;
    color: #d4d4d4;
    border: 1px solid #2a2a2a;
    font-family: Consolas, monospace;
    font-size: 11px;
}

/* ============================================================
   DIALOG LABELS
   (ConversionProgressDialog: status heading + section caption,
   reused for both the "Converting..." and "Conversion Complete"
   states)
   ============================================================
*/
QLabel[class="dialog-title"] {
    font-size: 16px;
    font-weight: bold;
}

QLabel[class="section-caption"] {
    font-size: 11px;
    font-weight: bold;
    color: #888;
}

/* ============================================================
   COVER ART
   ============================================================
*/
#coverArtImage {
    border: 1px solid palette(white);
    border-radius: 4px;
    color: palette(mid);
}

#coverArtInfo {
    color: palette(white);
    font-size: 11px;
}

#coverArtLabel {
    font-size: 12px;
}

/* ============================================================
   TRACK TABLE - PROGRESS CELL CONTAINER
   ============================================================
*/
#progressContainer {
    background-color: transparent;
}

/* ============================================================
   PROGRESS BAR
   ============================================================
*/
QProgressBar {
    background-color: transparent;
    border: 1px solid #3a3a3a;
    border-radius: 3px;
    text-align: center;
    color: #d4d4d4;
}

QProgressBar::chunk {
    background-color: #2d5f8a;
    border-radius: 2px;
}

/* ============================================================
   SPLITTER
   ============================================================
*/
QSplitter::handle {
    background-color: #2a2a2a;
}

/* ============================================================
   VERTICAL SCROLLBAR
   ============================================================
*/
QScrollBar:vertical {
    background: #1c1c1c;
    width: 12px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #3a3a3a;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #4a4a4a;
}

QScrollBar::handle:vertical:pressed {
    background: #5a7a9a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* ============================================================
   HORIZONTAL SCROLLBAR
   ============================================================
*/
QScrollBar:horizontal {
    background: #1c1c1c;
    height: 12px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #3a3a3a;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #4a4a4a;
}

QScrollBar::handle:horizontal:pressed {
    background: #5a7a9a;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}